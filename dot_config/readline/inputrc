set editing-mode vi
set show-mode-in-prompt on
set vi-cmd-mode-string "\1\e[2 q\2\1\e[38;2;17;17;27m\e[48;2;243;139;168m\2 CMD \1\e[0m\2"
set vi-ins-mode-string "\1\e[6 q\2\1\e[38;2;17;17;27m\e[48;2;180;190;254m\2 INS \1\e[0m\2"

$if mode=vi
    set keymap vi-command
    # these are for vi-command mode
    Control-l: clear-screen

    set keymap vi-insert
    # these are for vi-insert mode
    Control-l: clear-screen
$endif
