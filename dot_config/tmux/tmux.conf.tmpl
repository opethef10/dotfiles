{{- /* vps = true in ~/.config/chezmoi/chezmoi.toml [data] marks a server */ -}}
{{- $vps := and (hasKey . "vps") .vps -}}
unbind C-b
{{- if $vps }}
# Different prefix on servers so it doesn't clash with tmux on the local machine
set-option -g prefix M-x
bind-key M-x send-prefix
{{- else }}
set-option -g prefix M-z
bind-key M-z send-prefix
{{- end }}

set-window-option -g mode-keys vi

bind c new-window -c "#{pane_current_path}"

bind -n C-Left split-window -h -c "#{pane_current_path}"
bind -n C-Right split-window -h -c "#{pane_current_path}"
bind -n C-Down split-window -v -c "#{pane_current_path}"
bind -n C-Up split-window -v -c "#{pane_current_path}"

bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

bind -n S-Left  previous-window
bind -n S-Right next-window

{{- if $vps }}
# Fuzzy jump (tmux-fzf) on servers: Alt+Shift+o window, +s session, +i pane, +p command palette, +n new window from zoxide dir
# Shifted variants of the local keys: the local tmux binds Alt+o/s/i/p/n and would shadow a nested tmux
bind -n M-O run-shell -b "~/.local/share/tmux/plugins/tmux-fzf/scripts/window.sh switch"
bind -n M-S run-shell -b "~/.local/share/tmux/plugins/tmux-fzf/scripts/session.sh switch"
bind -n M-I run-shell -b "~/.local/share/tmux/plugins/tmux-fzf/scripts/pane.sh switch"
bind -n M-P run-shell -b "~/.local/share/tmux/plugins/tmux-fzf/scripts/command.sh"
bind -n M-N run-shell -b "~/.local/bin/tmux-zwin"
{{- else }}
# Fuzzy jump (tmux-fzf): Alt+o window, Alt+s session, Alt+i pane, Alt+p command palette, Alt+n new window from zoxide dir
bind -n M-o run-shell -b "~/.local/share/tmux/plugins/tmux-fzf/scripts/window.sh switch"
bind -n M-s run-shell -b "~/.local/share/tmux/plugins/tmux-fzf/scripts/session.sh switch"
bind -n M-i run-shell -b "~/.local/share/tmux/plugins/tmux-fzf/scripts/pane.sh switch"
bind -n M-p run-shell -b "~/.local/share/tmux/plugins/tmux-fzf/scripts/command.sh"
bind -n M-n run-shell -b "~/.local/bin/tmux-zwin"
{{- end }}

bind y source-file ~/.config/tmux/tmux.conf

set -g mouse on

# yazi compatible settings
set -g allow-passthrough on
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM

# Automatic window renaming
set-option -g automatic-rename off
set-option -g automatic-rename-format '#{pane_current_command}'

# Block programs from overriding window titles via escape sequences
set-option -g allow-rename off

# don't do anything when a 'bell' rings
set -g visual-activity off
set -g visual-bell off
set -g visual-silence off
setw -g monitor-activity off
set -g bell-action none

set-option -g status on
{{- /* servers refresh less often to keep load down */}}
set-option -g status-interval {{ if $vps }}5{{ else }}1{{ end }}
set-option -g status-justify centre
set-option -g status-keys vi
set-option -g status-position bottom
set-option -g status-style fg=colour136,bg=colour235
set-window-option -g window-status-style "fg=colour244,bg=default"
set-window-option -g window-status-current-style "fg=colour166,bg=default"
set-option -sg escape-time 10
set-option -g focus-events on

set -g pane-border-format "#P: #{pane_current_command}"
set -g pane-border-status top
set -g @catppuccin_window_text " #W "
set -g @catppuccin_window_current_text " #W "
set -g @catppuccin_flavor "mocha"
set -g @catppuccin_window_status_style "rounded"
set -g @catppuccin_date_time_text "%Y-%m-%d %H:%M"
set -g @catppuccin_window_flags "icon"

# Make the status line pretty and add some modules
set -g status-right-length 100
set -g status-left-length 100
set -g status-left ""
set -ag status-left "#{E:@catppuccin_status_host}"
set -ag status-left "#{E:@catppuccin_status_session}"
{{- if $vps }}
# Servers: only load, uptime and date
set -gF status-right "#{E:@catppuccin_status_load}"
{{- else }}
set -ag status-left "#{E:@catppuccin_status_application}"
set -gF status-right "#{E:@catppuccin_status_battery}"
set -agF status-right "#{E:@catppuccin_status_cpu}"
set -agF status-right "#{E:@catppuccin_status_ram}"
set -agF status-right "#{E:@catppuccin_status_load}"
{{- end }}
set -ag status-right "#{E:@catppuccin_status_uptime}"
set -ag status-right "#{E:@catppuccin_status_date_time}"
set-environment -g TMUX_PLUGIN_MANAGER_PATH "~/.local/share/tmux/plugins"
set -g @plugin 'tmux-plugins/tpm'

set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @plugin 'jaclu/tmux-menus'
set -g @plugin 'sainnhe/tmux-fzf'
set -g @plugin 'tmux-plugins/tmux-sidebar'
set -g @plugin 'tmux-plugins/tmux-battery'
set -g @plugin 'tmux-plugins/tmux-cpu'
set -g @plugin 'catppuccin/tmux#v2.3.0'

set -g @continuum-restore 'on'
TMUX_FZF_OPTIONS="-p -w 85% -h 75% -m"

run '~/.local/share/tmux/plugins/tpm/tpm'

set -g default-terminal "screen-256color"
set-option -a terminal-features 'xterm-256color:RGB'
